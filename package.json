{
  "name": "graphit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browse, customize and export chart designs as SVG, MP4 or code.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:metrics": "node scripts/gen-metrics.mjs",
    "geo": "node scripts/build-geo.mjs"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/pt-serif": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "lz-string": "1.5.0",
    "mediabunny": "1.62.1",
    "opentype.js": "2.0.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
